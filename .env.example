# Provider configs are independent. Each capability can use a different
# OpenAI-compatible API key, base URL, and model.
AGNES_PLATFORM_URL=https://platform.agnes-ai.com/

# Text provider: OpenAI-compatible /chat/completions.
AGNES_TEXT_API_KEY=YOUR_TEXT_PROVIDER_API_KEY
AGNES_TEXT_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_TEXT_MODEL=agnes-2.0-flash

# Image provider: OpenAI-compatible /images/generations.
AGNES_IMAGE_API_KEY=YOUR_IMAGE_PROVIDER_API_KEY
AGNES_IMAGE_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# Video provider: OpenAI-compatible /videos.
AGNES_VIDEO_API_KEY=YOUR_VIDEO_PROVIDER_API_KEY
AGNES_VIDEO_API_BASE_URL=https://apihub.agnes-ai.com/v1
# Optional status gateway without /v1 for providers that use a separate polling host.
AGNES_VIDEO_STATUS_BASE_URL=
AGNES_VIDEO_MODEL=agnes-video-v2.0

AGNES_TIMEOUT_SECONDS=360
AGNES_OUTPUT_DIR=outputs
AGNES_DB_PATH=backend/app/data/open_visual_agent.sqlite3

# Agent identity.
AGENT_IDENTITY=open_visual_agent
AGENT_DEFAULT_SCENARIO=growth_marketer
AGENT_ENABLE_TOOLS=true

# Optional: write a prompt inline or point to a prompt file.
AGENT_SYSTEM_PROMPT=
AGENT_SYSTEM_PROMPT_FILE=prompts/agent-system-prompt.md

# Semicolon-separated docs or prompt packs that the agent should know about.
AGENT_SKILLS_DOC_PATHS=README.md;prompts/visual-growth-pack.md
